ROUTER9_GATEWAY_URL=<fill-me>       # VPS: http://9router-api:20127/api/mcp-gateway ; local: http://host.docker.internal:20127/api/mcp-gateway
ROUTER9_GATEWAY_KEY=<fill-me>

# Tool access
GH_TOKEN=<fill-me>
GITLAB_TOKEN=<fill-me>

# Aux model used for kanban task decomposition
AUX_MODEL=<fill-me>